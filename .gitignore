# Dependencies
node_modules/

# Environment variables — API keys go here, never commit these
.env
.env.local
.env.*.local

# Vite build output
dist/

# Build / task logs — never commit throwaway build output
*.log

# OS files
.DS_Store
Thumbs.db

# Editor — ignore local Cursor state, but keep shared project config
# (Cloud Agents read environment.json + subagents/rules from the repo)
.cursor/*
!.cursor/environment.json
!.cursor/agents
!.cursor/agents/**
!.cursor/rules
!.cursor/rules/**
# Plans are un-ignored (19 Aug 2026): TASKS.md cited .cursor/plans/*.plan.md as the
# current execution order, but the path was ignored, so no agent session could read it —
# a governing pointer nobody can load is decoration (LESSONS-LEARNED Law S). Commit a
# plan here if it is meant to govern; until then TASKS.md itself is the execution order.
!.cursor/plans
!.cursor/plans/**
.vercel
.env*
